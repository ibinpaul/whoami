<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_navigation</name>
  <version>0.0.0</version>
  <description>
    Dev 3 costmap subsystem. costmap_core is the ROS-independent core;
    costmap_ros is the ROS 2 integration layer (input adapters and a skeleton costmap node).
  </description>
  <maintainer email="TODO@todo.todo">TODO</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
